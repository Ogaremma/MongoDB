<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update and Edit</title>
</head>
<body>
     <h1>Edit a Product</h1>
    <form action="/products/<%= product._id %>?_method=PUT" method="POST">
        <label for="name">Product Name:</label>
        <input type="text" id="name" name="name" required placeholder="product name" value="<%=product.name%>">
        <br>
        <label for="price">Price(unit):</label>
        <input type="number" id="price" name="price" required placeholder="price" value="<%=product.price%>">
        <br>
        <label for="category">Select Category:</label>
        <select name="category" id="category">
            <% for(let cat of categories) { %>
                <option value="<%=cat%>" <%= product.category === cat ? 'selected': '' %>><%=cat%></option>
            <% } %>
        </select>
        <br>
        <button type="submit">Update Product</button>
    </form>
    <a href="/products/<%=product._id%>">Cancel</a>
</body>
</html>